# Admin panel password (default in code is "student" if unset)
ADMIN_PASSWORD=student

# Cloudflare R2 via S3 API token (local + optional non-Worker use)
# Create token: Cloudflare Dashboard → R2 → Overview → Manage R2 API Tokens
# Permission: Object Read & Write on bucket uzkk-content
R2_ACCOUNT_ID=39f5c66364c1db3c630bb4777259c20c
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=uzkk-content

# Optional public base URL if the bucket has public access / custom domain:
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
